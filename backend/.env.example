DATABASE_URL=sqlite:///./sme.db
# Generate a long random secret; keep it stable across restarts.
JWT_SECRET=replace-with-a-long-random-secret-before-hosting
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO=true
# Optional: no key is required for deterministic mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional external web discovery (can also be saved per business in the UI).
TAVILY_API_KEY=
META_GRAPH_VERSION=v26.0
# Worker runs only configured schedules while the backend remains running.
AUTOMATION_WORKER=true
# Stable Fernet key for hosted credential encryption. Blank uses a private local key file.
SOCIAL_TOKEN_KEY=

# Optional eBay Browse production application token (also configurable per business in UI).
EBAY_APPLICATION_TOKEN=
